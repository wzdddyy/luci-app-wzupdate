#!/bin/sh /etc/rc.common
# wzupdate 自动检查服务

START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/wzupdate/autocheck
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

reload_service() {
	stop
	start
}
