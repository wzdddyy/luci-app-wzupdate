{
	"luci-app-wzupdate": {
		"description": "Grant access to the online firmware updater",
		"read": {
			"ubus": {
				"wzupdate": [ "status" ]
			},
			"uci": [ "wzupdate" ]
		},
		"write": {
			"ubus": {
				"wzupdate": [ "start", "check", "cancel", "rollback", "reboot" ]
			},
			"uci": [ "wzupdate" ],
			"file": {
				"/etc/init.d/wzupdate": [ "exec" ]
			}
		}
	}
}
